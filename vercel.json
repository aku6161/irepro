{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 18 * * 0"
    }
  ]
}
